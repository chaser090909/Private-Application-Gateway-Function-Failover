          <mxGeometry x="1900" y="1096" width="62" height="62" as="geometry" />
        </mxCell>
        <mxCell id="wb-text" value="&lt;b&gt;Private Application Gateway DR&lt;/b&gt;&lt;br&gt;probe health · secondary up · failback" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=9;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="1856" y="1164" width="190" height="52" as="geometry" />
