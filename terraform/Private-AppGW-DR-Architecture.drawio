          </mxGeometry>
        </mxCell>
        <mxCell id="lg-t3" value="&lt;b&gt;DNS write&lt;/b&gt; — the watchdog is the only writer of the app A record" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="164" y="869" width="482" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg-l4" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="84" y="910" as="sourcePoint" />
            <mxPoint x="152" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg-t4" value="&lt;b&gt;Control-plane reads&lt;/b&gt; — container state, custom probe health, then host-count metrics if needed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="164" y="897" width="482" height="26" as="geometry" />
