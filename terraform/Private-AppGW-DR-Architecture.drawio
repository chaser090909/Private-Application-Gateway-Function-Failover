        </mxCell>
        <mxCell id="lg-t2" value="&lt;b&gt;Failover path&lt;/b&gt; — primary probe down emails the action group, then DNS moves to Central US" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="164" y="841" width="482" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg-l3" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#107C10;strokeWidth=2.5;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="84" y="882" as="sourcePoint" />
