        <mxCell id="lg-t1" value="&lt;b&gt;Application traffic&lt;/b&gt; — HTTP :80 into whichever region is healthy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
