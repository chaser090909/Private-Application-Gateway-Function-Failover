        <mxCell id="lg-l5" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#8A8886;strokeWidth=1.5;dashed=1;dashPattern=4 4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
