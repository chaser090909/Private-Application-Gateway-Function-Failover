        <mxCell id="lbl-e2" value="answers&lt;br&gt;&lt;b&gt;10.1.1.10&lt;/b&gt; · East US" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=9;fontColor=#0B5FA8;" parent="1" vertex="1">
