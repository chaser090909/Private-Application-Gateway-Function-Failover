  <diagram id="page-failover" name="Failover logic">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1120" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-title-bar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243A5E;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1760" height="86" as="geometry" />
        </mxCell>
        <mxCell id="f-title-text" value="&lt;div style=&#39;font-size:24px;font-weight:600&#39;&gt;Failover decision logic — three signals, one decision&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#C3D8EF;margin-top:5px&#39;&gt;How the watchdog decides which region serves, and the rules that stop traffic from being handed back to a region that is still down&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="66" y="44" width="1240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-title-meta" value="function/function_app.py&lt;br&gt;timer + /api/region-failover&lt;br&gt;Diagram rev 1.3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#9FBEDD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="46" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f-hdr-signals" value="Signals" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="60" y="148" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="f-trig1" value="&lt;b&gt;Trigger 1 — timer&lt;/b&gt;&lt;br&gt;&lt;i&gt;*/30 * * * * *&lt;/i&gt; — every 30 seconds. Always On on the B1 plan keeps the worker warm, so the tick never stalls. This is the primary path and it waits for nothing." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9F5FC;strokeColor=#5C2D91;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="60" y="182" width="320" height="118" as="geometry" />
        </mxCell>
        <mxCell id="f-trig2" value="&lt;b&gt;Trigger 2 — webhook&lt;/b&gt;&lt;br&gt;POST &lt;i&gt;/api/region-failover&lt;/i&gt; with a function key, called by &lt;b&gt;ag-appgw-dr-failover&lt;/b&gt; when:&lt;br&gt;• the primary custom probe is down (UnhealthyHostCount ≥ 1 on agw-eus-dr) — this also emails chase.goebel@ibm.com and fails over to Central US&lt;br&gt;• the primary backend container is stopped&lt;br&gt;&lt;br&gt;Watchdog exceptions email only (ag-appgw-dr-email) and do not call this webhook. The alert payload is logged, then live probe health is re-read." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9F5FC;strokeColor=#5C2D91;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="60" y="316" width="320" height="176" as="geometry" />
        </mxCell>
        <mxCell id="f-trig-note" value="&lt;b&gt;Why two paths&lt;/b&gt;&lt;br&gt;The timer is the primary path; the alerts are a second path that shortcuts the wait. Both call the same code, and that code always re-reads live state from ARM rather than trusting an alert payload — so a stale or spurious alert cannot move traffic, and repeated calls are harmless." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="60" y="508" width="320" height="152" as="geometry" />
        </mxCell>
        <mxCell id="f-drill" value="&lt;b&gt;Proving it — scripts/dr-drill&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;validate&lt;/b&gt; — inventory, container and gateway state, backend health, DNS target, alert status, and which triggers the watchdog indexed&lt;br&gt;&lt;br&gt;&lt;b&gt;failover&lt;/b&gt; — stops the primary container and polls until DNS moves&lt;br&gt;&lt;br&gt;&lt;b&gt;restore&lt;/b&gt; — starts both containers and waits for the &lt;i&gt;watchdog&lt;/i&gt; to fail back rather than setting the record itself, because the failback rule is the part most worth testing&lt;br&gt;&lt;br&gt;&lt;b&gt;webhook&lt;/b&gt; — posts a synthetic common-alert-schema payload and prints the decision" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="320" height="290" as="geometry" />
        </mxCell>
        <mxCell id="f-hdr-flow" value="One decision function — evaluate(trigger)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="470" y="148" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="f-fn-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1">
          <mxGeometry x="470" y="188" width="84" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f-ev" value="&lt;b&gt;evaluate(trigger)&lt;/b&gt;&lt;br&gt;re-reads live ARM state on every call" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9F5FC;strokeColor=#5C2D91;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B2379;" vertex="1" parent="1">
          <mxGeometry x="580" y="190" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-d1" value="aci-eus-dr state = &lt;b&gt;Running&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="580" y="300" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f-d2" value="agw-eus-dr &lt;b&gt;probe health&lt;/b&gt;&lt;br&gt;Up or Healthy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f-a1" value="&lt;b&gt;PUT app → 10.1.1.10&lt;/b&gt;&lt;br&gt;East US serves. No write when the record already matches.&lt;br&gt;A real change logs &lt;b&gt;FAILBACK_PRIMARY&lt;/b&gt; and &lt;b&gt;alert-failback-primary&lt;/b&gt; emails. No webhook." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F5EA;strokeColor=#107C10;strokeWidth=2;fontSize=11;fontColor=#0B5A0B;" vertex="1" parent="1">
          <mxGeometry x="1020" y="440" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f-d3" value="aci-cus-dr state = &lt;b&gt;Running&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;fontSize=11;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="580" y="596" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f-d4" value="agw-cus-dr &lt;b&gt;probe health&lt;/b&gt;&lt;br&gt;Up or Healthy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D83B01;strokeWidth=2;fontSize=11;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="580" y="736" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f-a2" value="&lt;b&gt;PUT app → 10.2.1.10&lt;/b&gt;&lt;br&gt;Central US serves within one TTL.&lt;br&gt;While it can serve, each check logs &lt;b&gt;SECONDARY_REGION_UP&lt;/b&gt;. &lt;b&gt;alert-secondary-region-up&lt;/b&gt; emails and stays fired until those logs stop." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF0E8;strokeColor=#D83B01;strokeWidth=2;fontSize=11;fontColor=#A83500;" vertex="1" parent="1">
          <mxGeometry x="1020" y="736" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-a3" value="&lt;b&gt;Neither region is up&lt;/b&gt;&lt;br&gt;log at critical severity and leave DNS exactly where it is" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A80000;strokeWidth=2;fontSize=11;fontColor=#8B0000;" vertex="1" parent="1">
          <mxGeometry x="1020" y="900" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-aci1" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/containers/Container_Instances.svg;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="34" height="36" as="geometry" />
        </mxCell>
        <mxCell id="f-agw1" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1">
          <mxGeometry x="498" y="470" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="f-aci2" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/containers/Container_Instances.svg;" vertex="1" parent="1">
          <mxGeometry x="500" y="626" width="34" height="36" as="geometry" />
        </mxCell>
        <mxCell id="f-agw2" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1">
          <mxGeometry x="498" y="766" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="f-dns1" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1">
          <mxGeometry x="1362" y="476" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="f-dns2" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1">
          <mxGeometry x="1362" y="772" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="f-e-trig1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-trig1" target="f-fn-icon">
          <mxGeometry relative="1" as="geometry" />
