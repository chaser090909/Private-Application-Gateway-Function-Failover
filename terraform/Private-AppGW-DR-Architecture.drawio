        </mxCell>
        <mxCell id="wd-mi-text" value="system-assigned&lt;br&gt;managed identity" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=9;fontColor=#4B2379;" parent="1" vertex="1">
          <mxGeometry x="1887" y="320" width="116" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wd-st-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/storage/Storage_Accounts.svg;" parent="1" vertex="1">
          <mxGeometry x="1618" y="392" width="78" height="62" as="geometry" />
        </mxCell>
        <mxCell id="wd-st-text" value="&lt;b&gt;stagwdr&lt;/b&gt;&lt;br&gt;AzureWebJobsStorage&lt;br&gt;identity-based · no keys" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=9;fontColor=#4B2379;" parent="1" vertex="1">
          <mxGeometry x="1594" y="460" width="126" height="56" as="geometry" />
        </mxCell>
        <mxCell id="wd-trig-text" value="&lt;b&gt;Two triggers, one decision function&lt;/b&gt;&lt;br&gt;• timer &lt;b&gt;*/30 * * * * *&lt;/b&gt; — every 30 seconds&lt;br&gt;• POST &lt;b&gt;/api/region-failover&lt;/b&gt; — function key&lt;br&gt;&lt;br&gt;&lt;b&gt;Every call re-reads live ARM state&lt;/b&gt;&lt;br&gt;1 · container group state must be &lt;i&gt;Running&lt;/i&gt;&lt;br&gt;2 · custom probe must be Up or Healthy&lt;br&gt;&lt;i&gt;backendhealth&lt;/i&gt;, or host-count metrics if that call returns no servers&lt;br&gt;&lt;br&gt;The webhook uses the metrics read so the email action group is not blocked on the health LRO." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="1740" y="384" width="322" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mon-box" value="Monitoring and alerting — rg-appgw-dr-shared" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF7EF;strokeColor=#B05E00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#8A4B00;" parent="1" vertex="1">
          <mxGeometry x="1580" y="640" width="500" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ag-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/management_governance/Monitor.svg;" parent="1" vertex="1">
          <mxGeometry x="1606" y="692" width="62" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ag-text" value="&lt;b&gt;ag-appgw-dr-failover&lt;/b&gt; (agwdr) — email + webhook&lt;br&gt;primary probe down emails &lt;b&gt;chase.goebel@ibm.com&lt;/b&gt; and POST /api/region-failover moves DNS to Central US&lt;br&gt;&lt;br&gt;&lt;b&gt;ag-appgw-dr-email&lt;/b&gt; (agwemail) — email only, no webhook&lt;br&gt;secondary region up, failback to East US, watchdog exceptions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="1684" y="678" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="alerts-box" value="Alerts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDB58A;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#8A4B00;" parent="1" vertex="1">
          <mxGeometry x="1600" y="786" width="460" height="248" as="geometry" />
        </mxCell>
        <mxCell id="alerts-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/management_governance/Alerts.svg;" parent="1" vertex="1">
          <mxGeometry x="1614" y="830" width="48" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alerts-text" value="&lt;b&gt;Failover group&lt;/b&gt; — email and move DNS&lt;br&gt;&lt;b&gt;alert-primary-probe-down&lt;/b&gt; — UnhealthyHostCount ≥ 1 on agw-eus-dr, sev 1&lt;br&gt;&lt;b&gt;alert-aci-stopped&lt;/b&gt; — primary container stop&lt;br&gt;&lt;b&gt;alert-secondary-probe-down&lt;/b&gt; — agw-cus-dr; watchdog will not move onto a dead secondary&lt;br&gt;&lt;br&gt;&lt;b&gt;Email only&lt;/b&gt; — ag-appgw-dr-email, no webhook&lt;br&gt;&lt;b&gt;alert-secondary-region-up&lt;/b&gt; — log SECONDARY_REGION_UP while Central US can serve&lt;br&gt;&lt;b&gt;alert-failback-primary&lt;/b&gt; — log FAILBACK_PRIMARY when DNS returns to East US&lt;br&gt;&lt;b&gt;alert-watchdog-exceptions&lt;/b&gt; — unhandled exceptions in the function" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" parent="1" vertex="1">
          <mxGeometry x="1668" y="818" width="380" height="206" as="geometry" />
        </mxCell>
        <mxCell id="tel-box" value="Telemetry" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDB58A;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#8A4B00;" parent="1" vertex="1">
