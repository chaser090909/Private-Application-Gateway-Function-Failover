        <mxCell id="title-text" value="&lt;div style=&#39;font-size:24px;font-weight:600&#39;&gt;Private Application Gateway — Multi-Region Disaster Recovery&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#C3D8EF;margin-top:5px&#39;&gt;Private-only Application Gateways in East US and Central US · Azure Container Instances backends on private IPs · a watchdog Function App repoints a private DNS record from live ARM state&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;" parent="1" vertex="1">
