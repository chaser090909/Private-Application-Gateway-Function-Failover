        <mxCell id="f-e-trig2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C2D91;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-trig2" target="f-fn-icon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="360" />
              <mxPoint x="430" y="290" />
              <mxPoint x="512" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#243A5E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-ev" target="f-d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#0B5FA8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d1" target="f-d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#0B5A0B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d2" target="f-a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#B33A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d1" target="f-d3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="448" y="348" />
              <mxPoint x="448" y="644" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0.75;entryDx=0;entryDy=0;fontSize=10;fontColor=#B33A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d2" target="f-d3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="488" />
              <mxPoint x="470" y="668" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#B33A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d3" target="f-d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D83B01;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#B33A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d4" target="f-a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A80000;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=10;fontColor=#8B0000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="f-d3" target="f-a3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="644" />
              <mxPoint x="950" y="930" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A80000;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;fontSize=10;fontColor=#8B0000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f-d4" target="f-a3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-hdr-rules" value="Rules that matter" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="1430" y="148" width="330" height="26" as="geometry" />
        </mxCell>
        <mxCell id="f-n1" value="&lt;b&gt;Failback requires &lt;i&gt;now&lt;/i&gt;&lt;/b&gt;&lt;br&gt;Returning traffic to East US requires aci-eus-dr to be Running and the primary probe to be up. The email fires only when DNS actually changes, via FAILBACK_PRIMARY. A stale HealthyHostCount sample cannot send traffic back by itself." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1430" y="182" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-n2" value="&lt;b&gt;Steady state writes nothing&lt;/b&gt;&lt;br&gt;point_dns_at reads the current record first and returns early when it already matches, so the 30-second tick stays read-only until something actually changes. That is also what makes repeated webhook calls harmless." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1430" y="372" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f-n3" value="&lt;b&gt;Container state gates everything&lt;/b&gt;&lt;br&gt;A container that is not Running is treated as down immediately. Probe health comes from backendhealth. If that call returns no servers, HealthyHostCount and UnhealthyHostCount decide. The webhook uses the metrics read so the email action group is not blocked on the health call." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1430" y="562" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f-n4" value="&lt;b&gt;Both down is not a reason to move&lt;/b&gt;&lt;br&gt;Repointing at a second dead region buys nothing and would hide the outage, so the record is left alone and the event is logged at critical severity — where alert-watchdog-exceptions and the workbook&#39;s decision panel surface it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C7D2E0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1430" y="742" width="330" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-inventory" name="Inventory">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="i-title-bar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243A5E;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1760" height="86" as="geometry" />
        </mxCell>
        <mxCell id="i-title-text" value="&lt;div style=&#39;font-size:24px;font-weight:600&#39;&gt;Resource inventory and deployment facts&lt;/div&gt;&lt;div style=&#39;font-size:13px;color:#C3D8EF;margin-top:5px&#39;&gt;Each region owns a resource group so it can be torn down independently; a shared group holds what has to survive losing either one&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="66" y="44" width="1240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i-title-meta" value="Approximately 50 resources&lt;br&gt;&amp;lt;suffix&amp;gt; is a random 8-character string&lt;br&gt;Diagram rev 1.3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#9FBEDD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="46" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="i-rg1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="i-rg1-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1">
          <mxGeometry x="84" y="196" width="56" height="53" as="geometry" />
        </mxCell>
        <mxCell id="i-rg1-name" value="&lt;b&gt;rg-appgw-dr-eus&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#5B6B85&#39;&gt;Primary region · East US&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="152" y="196" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="i-rg1-list" value="&lt;b&gt;Networking&lt;/b&gt;&lt;br&gt;vnet-eus-dr · 10.1.0.0/16&lt;br&gt;snet-appgw-eus · 10.1.1.0/24 — delegated to Microsoft.Network/applicationGateways&lt;br&gt;snet-aci-eus · 10.1.2.0/24 — delegated to Microsoft.ContainerInstance/containerGroups&lt;br&gt;snet-client · 10.1.10.0/24&lt;br&gt;peer-eus-to-cus&lt;br&gt;&lt;br&gt;&lt;b&gt;Outbound&lt;/b&gt;&lt;br&gt;nat-aci-eus and pip-nat-eus — Standard, static, 10-minute idle. A container group with a private IP has no outbound path of its own.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workload&lt;/b&gt;&lt;br&gt;aci-eus-dr — aci-helloworld, 1 vCPU / 1 GB, private IP, restart policy Always&lt;br&gt;agw-eus-dr — Standard_v2, capacity 1, private frontend 10.1.1.10, listener HTTP :80, probe / matching 200-399&lt;br&gt;&lt;br&gt;&lt;b&gt;Diagnostics&lt;/b&gt;&lt;br&gt;to-log-analytics → law-appgw-dr (ApplicationGatewayAccessLog + AllMetrics)&lt;br&gt;&lt;br&gt;&lt;b&gt;Optional test client&lt;/b&gt;&lt;br&gt;vm-test, nic-vm-test, pip-vm-test — off unless deploy_test_vm is true" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="84" y="270" width="512" height="310" as="geometry" />
        </mxCell>
        <mxCell id="i-rg2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="170" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="i-rg2-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1">
          <mxGeometry x="664" y="196" width="56" height="53" as="geometry" />
        </mxCell>
        <mxCell id="i-rg2-name" value="&lt;b&gt;rg-appgw-dr-cus&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#5B6B85&#39;&gt;Secondary region · Central US&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="732" y="196" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="i-rg2-list" value="&lt;b&gt;Networking&lt;/b&gt;&lt;br&gt;vnet-cus-dr · 10.2.0.0/16&lt;br&gt;snet-appgw-cus · 10.2.1.0/24 — delegated to Microsoft.Network/applicationGateways&lt;br&gt;snet-aci-cus · 10.2.2.0/24 — delegated to Microsoft.ContainerInstance/containerGroups&lt;br&gt;peer-cus-to-eus&lt;br&gt;&lt;br&gt;&lt;b&gt;Outbound&lt;/b&gt;&lt;br&gt;nat-aci-cus and pip-nat-cus — Standard, static, 10-minute idle&lt;br&gt;&lt;br&gt;&lt;b&gt;Workload&lt;/b&gt;&lt;br&gt;aci-cus-dr — aci-helloworld, 1 vCPU / 1 GB, private IP, restart policy Always&lt;br&gt;agw-cus-dr — Standard_v2, capacity 1, private frontend 10.2.1.10, listener HTTP :80, probe / matching 200-399&lt;br&gt;&lt;br&gt;&lt;b&gt;Diagnostics&lt;/b&gt;&lt;br&gt;to-log-analytics → law-appgw-dr (ApplicationGatewayAccessLog + AllMetrics)&lt;br&gt;&lt;br&gt;&lt;b&gt;Built by the same module&lt;/b&gt;&lt;br&gt;modules/region is called twice, so listeners, probes, routing rules, and timeouts are identical in both regions by construction. Changes there apply to both at once, which is the point." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="664" y="270" width="512" height="310" as="geometry" />
        </mxCell>
        <mxCell id="i-rg3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1220" y="170" width="570" height="450" as="geometry" />
        </mxCell>
        <mxCell id="i-rg3-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1">
          <mxGeometry x="1244" y="196" width="56" height="53" as="geometry" />
        </mxCell>
        <mxCell id="i-rg3-name" value="&lt;b&gt;rg-appgw-dr-shared&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#5B6B85&#39;&gt;Survives losing either region&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#4B2379;" vertex="1" parent="1">
          <mxGeometry x="1312" y="196" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="i-rg3-list" value="&lt;b&gt;Private DNS&lt;/b&gt;&lt;br&gt;internal.contoso.com&lt;br&gt;link-eus and link-cus — VNet links, autoregistration off&lt;br&gt;app A record · TTL 30 — Terraform-seeded, watchdog-owned&lt;br&gt;&lt;br&gt;&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;plan-appgw-dr-&amp;lt;suffix&amp;gt; — B1 with Always On&lt;br&gt;func-appgw-dr-&amp;lt;suffix&amp;gt; — Linux, Python 3.11, system-assigned identity, no VNet integration&lt;br&gt;stagwdr&amp;lt;suffix&amp;gt; — storage_uses_managed_identity, no key ever read into config&lt;br&gt;&lt;br&gt;&lt;b&gt;Telemetry&lt;/b&gt;&lt;br&gt;law-appgw-dr-&amp;lt;suffix&amp;gt; — PerGB2018, 30-day retention&lt;br&gt;appi-appgw-dr-&amp;lt;suffix&amp;gt; — workspace-based Application Insights&lt;br&gt;Private Application Gateway DR — workbook of probe health, secondary-region-up, and failback to primary&lt;br&gt;&lt;br&gt;&lt;b&gt;Alerting&lt;/b&gt;&lt;br&gt;ag-appgw-dr-failover — email chase.goebel@ibm.com and webhook; primary probe down fails over to Central US&lt;br&gt;ag-appgw-dr-email — email only, for watchdog exceptions&lt;br&gt;alert-primary-probe-down and alert-secondary-probe-down&lt;br&gt;alert-aci-stopped — primary container&lt;br&gt;alert-watchdog-exceptions&lt;br&gt;alert-secondary-region-up — Central US can serve, email only&lt;br&gt;alert-failback-primary — traffic sent back to East US, email only" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1244" y="270" width="522" height="330" as="geometry" />
        </mxCell>
        <mxCell id="i-sub-box" value="Subscription scope" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDFBFF;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#4B2379;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="1140" height="180" as="geometry" />
        </mxCell>
        <mxCell id="i-sub-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1">
          <mxGeometry x="84" y="686" width="44" height="71" as="geometry" />
        </mxCell>
        <mxCell id="i-sub-text" value="&lt;b&gt;Private AppGW DR Watchdog (&amp;lt;suffix&amp;gt;)&lt;/b&gt; — a custom role definition at subscription scope: read container groups, read Application Gateways, POST applicationGateways/backendhealth, and read Microsoft.Insights metrics. It survives resource group deletion.&lt;br&gt;&lt;br&gt;&lt;b&gt;Run once per subscription&lt;/b&gt; — scripts/register-prereqs registers seven resource providers, requests the &lt;b&gt;EnableApplicationGatewayNetworkIsolation&lt;/b&gt; preview feature, polls until it reports Registered, then re-registers Microsoft.Network so the flag propagates. Without that feature a gateway cannot run with a private-only frontend. It is a script rather than Terraform because provider and feature registration are subscription-wide, one-time, and effectively irreversible." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="148" y="680" width="1032" height="130" as="geometry" />
        </mxCell>
        <mxCell id="i-facts-box" value="Deployment facts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#243A5E;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="1220" y="630" width="570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="i-facts-text" value="&lt;b&gt;terraform apply&lt;/b&gt; — 25 to 35 minutes; the two gateways dominate.&lt;br&gt;&lt;b&gt;Permissions&lt;/b&gt; — Owner or Contributor &lt;b&gt;plus&lt;/b&gt; User Access Administrator, because the stack creates its own role definition and assignments.&lt;br&gt;&lt;b&gt;Function code&lt;/b&gt; — published with --build-remote true so Oryx installs azure-identity on the platform. WEBSITE_RUN_FROM_PACKAGE is deliberately absent.&lt;br&gt;&lt;b&gt;State&lt;/b&gt; — local by default; move to a remote backend for shared use." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="1244" y="680" width="522" height="130" as="geometry" />
        </mxCell>
        <mxCell id="i-knobs-box" value="Defaults you are most likely to change (variables.tf)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="1730" height="170" as="geometry" />
        </mxCell>
        <mxCell id="i-knobs-text" value="&lt;b&gt;Addressing&lt;/b&gt;   primary_vnet_address_space 10.1.0.0/16 · secondary_vnet_address_space 10.2.0.0/16 · primary_appgw_private_ip 10.1.1.10 · secondary_appgw_private_ip 10.2.1.10 · client_subnet_prefix 10.1.10.0/24&lt;br&gt;&lt;b&gt;DNS&lt;/b&gt;   private_dns_zone_name internal.contoso.com · dns_record_name app · dns_record_ttl 30&lt;br&gt;&lt;b&gt;Watchdog&lt;/b&gt;   app_service_plan_sku B1 (must support Always On) · python_version 3.11 · watchdog_schedule */30 * * * * * (six fields, so the first is seconds) · backend_healthy_states [Up, Healthy]&lt;br&gt;&lt;b&gt;Workload&lt;/b&gt;   container_image mcr.microsoft.com/azuredocs/aci-helloworld · container_port 80 · container_cpu 1 · container_memory_in_gb 1 · appgw_capacity 1 · health_probe_path /&lt;br&gt;&lt;b&gt;Monitoring&lt;/b&gt;   log_retention_in_days 30 · unhealthy_host_threshold 1 · alert_email_address chase.goebel@ibm.com — primary probe down emails this address and fails over to Central US&lt;br&gt;&lt;b&gt;Test client&lt;/b&gt;   deploy_test_vm false · test_vm_size Standard_B2s_v2 · test_vm_ssh_public_key required when the VM is enabled" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#33415C;" vertex="1" parent="1">
          <mxGeometry x="84" y="886" width="1682" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
