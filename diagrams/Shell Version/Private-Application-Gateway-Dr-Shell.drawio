        <mxCell id="i-106" value="" style="image;aspect=fixed;html=1;align=center;verticalAlign=middle;imageAspect=0;image=img/lib/azure2/networking/DNS_Zones.svg;fontFamily=Segoe UI;" parent="1" vertex="1">
